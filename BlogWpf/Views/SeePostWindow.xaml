<Window x:Class="BlogWpf.Views.SeePostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlogWpf"
        mc:Ignorable="d"
        Title="SeePostWindow" Height="400" Width="450">
    <StackPanel>
        <Label Content="Post Details" FontSize="30" HorizontalAlignment="Center" Margin="10"/>
        <StackPanel Margin="10">
            <TextBlock Text="{Binding Post.Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <!--CAMBIA I TEXTBLOCK IN TEXTBOX COSì POI LI FAI MODIFICARE EH-->
            <TextBlock Text="{Binding Post.Content}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Post.CreatedAt, StringFormat='Created At: {0:dd/MM/yyyy HH:mm}'}" FontStyle="Italic"/>
        </StackPanel>
        <StackPanel
            Orientation="Vertical"
            HorizontalAlignment="Center"
            Margin="30">
            <Button Content="Edit" Margin="5" Height="25" Width="300" Padding="5" Command="{Binding EditPostCommand}"/>
            <Button Content="Delete" Margin="5" Height="25" Width="300" Padding="5" Command="{Binding DeletePostCommand}"/>
            <Button Content="Save" Margin="5" Height="25" Width="300" Padding="5" Command="{Binding UpdatePostCommand}"/>
            <Button Content="Close" Margin="5" Click="CloseWindow_Click" Height="25" Width="300"/>
        </StackPanel>
    </StackPanel>   
</Window>
